# Copy to .env and fill in. Never commit real secrets.
# compose.yaml reads these; defaults below match the local developer preview.

# --- Frontend / CORS ---
GUESTLIFT_APP_URL=http://localhost:3000
# Comma-separated browser origins allowed for CORS and the CSRF origin check.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
GUESTLIFT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Unauthenticated, shared-dataset demo API (import/upload/metrics/campaigns).
# Leave UNSET on any hosted build. compose.yaml sets it to 1 for local use.
# GUESTLIFT_ENABLE_DEMO_ENDPOINTS=1

# Set to 0 on hosted deployments and run `alembic upgrade head` instead (docs/MIGRATIONS.md).
# GUESTLIFT_AUTO_CREATE_SCHEMA=1

# Log level: DEBUG, INFO, WARNING, ERROR
# GUESTLIFT_LOG_LEVEL=INFO
# json = one JSON object per line with request_id (for log shippers)
# GUESTLIFT_LOG_FORMAT=json

# --- Authentication (hosted deployments: see docs/AUTH.md) ---
# local (default) = built-in development accounts. oidc = tokens from a managed provider.
# GUESTLIFT_ENV=production refuses to start in local mode, and also unless:
#   DATABASE_URL is PostgreSQL, GUESTLIFT_APP_URL and GUESTLIFT_ALLOWED_ORIGINS are https://,
#   demo endpoints/reset are unset, GUESTLIFT_AUTO_CREATE_SCHEMA=0 and TABLESIGNAL_CREDENTIAL_KEY is set.
# GUESTLIFT_ENV=
# GUESTLIFT_AUTH_MODE=local
# GUESTLIFT_OIDC_ISSUER=https://your-instance.clerk.accounts.dev
# GUESTLIFT_OIDC_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: require this `aud` claim.
# GUESTLIFT_OIDC_AUDIENCE=
# Optional but recommended with Clerk: comma-separated frontend origins checked against `azp`.
# GUESTLIFT_OIDC_AUTHORIZED_PARTIES=https://app.example.com

# Frontend (build time): local (default) or clerk. Clerk mode also needs the publishable key.
# NEXT_PUBLIC_AUTH_MODE=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Only for the Clerk journey test (scripts/journey.sh), never in the frontend build:
# CLERK_SECRET_KEY=sk_test_...

# --- Stripe (test mode only in the current build) --- (see docs/BILLING.md)
# GUESTLIFT_TRIAL_DAYS=14
# GUESTLIFT_PAYMENT_GRACE_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_GROWTH_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Square --- (see docs/PIPELINE.md)
# sandbox (default) or production. Production also needs GUESTLIFT_ALLOW_SQUARE_PRODUCTION=1 (only after Gate P0).
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_APP_ID= / SQUARE_APP_SECRET= / SQUARE_REDIRECT_URI=   (Sandbox also accepts the SQUARE_SANDBOX_* names below)
# Revocation webhook: signature key from the Square app, and the exact public webhook URL.
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://api.example.com/api/integrations/square/webhook
# Sync tuning (defaults shown)
# GUESTLIFT_BACKFILL_DAYS=395
# GUESTLIFT_SYNC_INTERVAL_HOURS=4
# GUESTLIFT_SYNC_INLINE_SECONDS=20
# GUESTLIFT_WORKER_SLICE_SECONDS=60
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APP_ID=
SQUARE_SANDBOX_APP_SECRET=
SQUARE_SANDBOX_REDIRECT_URI=http://localhost:8000/api/integrations/square/oauth/callback
# TEST ONLY: point the backend at the mock Square API (backend/mock_square). Refused in production.
# SQUARE_API_BASE_URL=http://localhost:8100
# Frontend build-time, TEST ONLY: allow OAuth redirects to the mock's authorize page.
# NEXT_PUBLIC_SQUARE_AUTHORIZE_ORIGIN=http://localhost:8100
# Fernet key used to encrypt stored Square tokens.
TABLESIGNAL_CREDENTIAL_KEY=

# --- Optional AI features ---
GUESTLIFT_ENABLE_LLM=0
# Per-user cap on AI questions per hour (0 disables). Per API process.
# GUESTLIFT_AI_QUESTIONS_PER_HOUR=60
OPENAI_API_KEY=
OPENAI_MODEL=
